Use 'T[]' instead.","TSTypeReference","errorStringArray",{"range":"309","text":"310"},"import/first","Import in body of module; reorder to top.","ImportDeclaration",{"range":"311","text":"312"},{"range":"313","text":"314"},"@typescript-eslint/no-unused-vars","'Platform' is defined but never used.","unusedVar","react-hooks/rules-of-hooks","React Hook \"useMemo\" is called conditionally. React Hooks must be called in the exact same order in every component render. Did you accidentally call a React Hook after an early return?","Identifier","react-hooks/exhaustive-deps","React Hook useEffect has a missing dependency: 'initialRegion'. Either include it or remove the dependency array.","ArrayExpression",["315"],"@typescript-eslint/no-require-imports","A `require()` style import is forbidden.","CallExpression","noRequireImports","React Hook \"useRef\" is called conditionally. React Hooks must be called in the exact same order in every component render. Did you accidentally call a React Hook after an early return?","React Hook \"useCallback\" is called conditionally. React Hooks must be called in the exact same order in every component render. Did you accidentally call a React Hook after an early return?","React Hook \"useEffect\" is called conditionally. React Hooks must be called in the exact same order in every component render. Did you accidentally call a React Hook after an early return?","React Hook \"useImperativeHandle\" is called conditionally. React Hooks must be called in the exact same order in every component render. Did you accidentally call a React Hook after an early return?","The ref value 'markersRef.current' will likely have changed by the time this effect cleanup function runs. If this ref points to a node rendered by React, copy 'markersRef.current' to a variable inside the effect, and use that variable in the cleanup function.","The ref value 'polylineIdsRef.current' will likely have changed by the time this effect cleanup function runs. If this ref points to a node rendered by React, copy 'polylineIdsRef.current' to a variable inside the effect, and use that variable in the cleanup function.",[1505,1593],"{\n  value: string;\n  label: string;\n  description: string;\n  icon: IoniconName;\n}[]",[659,659],"",[0,715],"// Minimal API helpers for auth. For Expo on device/emulator, localhost usually points to the device\n// so we try to infer the host from Expo Constants (packager host). You can still override with\n// process.env.API_BASE_URL if needed.\nimport Constants from 'expo-constants';\nimport { NativeModules, Platform } from 'react-native';\nexport async function getDonorProfile(token) {\n  return request('/api/donors/profile/', {\n    method: 'GET',\n    headers: { Authorization: `Token ${token}` },\n  });\n}\n\nexport async function updateDonorProfile(token, payload) {\n  return request('/api/donors/profile/', {\n    method: 'PATCH',\n    headers: { Authorization: `Token ${token}` },\n    body: JSON.stringify(payload),\n  });\n}",{"desc":"316","fix":"317"},"Update the dependencies array to be: [initialRegion.latitude, initialRegion.longitude, initialRegion.latitudeDelta, initialRegion.longitudeDelta, initialRegion]",{"range":"318","text":"319"},[7211,7319],"[initialRegion.latitude, initialRegion.longitude, initialRegion.latitudeDelta, initialRegion.longitudeDelta, initialRegion]"]