n}\n\nexport async function updateDonorProfile(token, payload) {\n  return request('/api/donors/profile/', {\n    method: 'PATCH',\n    headers: { Authorization: `Token ${token}` },\n    body: JSON.stringify(payload),\n  });\n}"]